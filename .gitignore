# NetSage AI — Root .gitignore
# Applies to both backend/ and frontend/

# ──────────────────────────────────────────────────
# Python / Backend
# ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
venv/
env/
.venv/

# Database files
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal

# Alembic compiled
alembic/versions/*.pyc

# Coverage & test cache
.pytest_cache/
.coverage
htmlcov/
*.xml

# Logs
*.log
logs/

# Environment secrets
.env
*.env
!.env.example

# ──────────────────────────────────────────────────
# Node / Frontend
# ──────────────────────────────────────────────────
node_modules/
.next/
.nuxt/
out/
dist/
.cache/
.turbo/
*.local

# ──────────────────────────────────────────────────
# OS / IDE
# ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# ──────────────────────────────────────────────────
# Docker
# ──────────────────────────────────────────────────
.dockerignore
