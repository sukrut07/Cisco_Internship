# =============================================================================
# NetSage AI Backend — Environment Variables
# Copy this to .env and fill in your values
# =============================================================================

# Application
APP_NAME=NetSage AI
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# Database (SQLite for development)
DATABASE_URL=sqlite:///./netsage.db

# AI Provider Configuration
# Options: mock | openai | gemini | anthropic
AI_PROVIDER=mock
AI_MODEL=
AI_API_KEY=

# AI Fallback: set to "mock" to fall back to mock on provider failure
AI_FALLBACK_PROVIDER=

# Logging
LOG_LEVEL=INFO

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8501,http://localhost:8000

# Security
SECRET_KEY=change-me-in-production-use-a-long-random-string

# Prompt versioning
PROMPT_VERSION=netsage-diagnose-v1
