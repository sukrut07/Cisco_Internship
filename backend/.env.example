# =============================================================================
# NetSage AI Backend — Environment Variables
# Copy this to .env and fill in your values
# =============================================================================

# Application
APP_NAME=NetSage AI
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# Database (SQLite for development, PostgreSQL for production)
DATABASE_URL=sqlite:///./netsage.db
# DATABASE_URL=postgresql://user:password@localhost:5432/netsage

# AI Provider Configuration
# Options: mock | openai | gemini | anthropic
AI_PROVIDER=mock
AI_MODEL=
AI_API_KEY=

# AI Reliability & Timeouts
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=3

# AI Fallback: set to "mock" to fall back to mock on provider failure
AI_FALLBACK_PROVIDER=

# Logging (DEBUG | INFO | WARNING | ERROR | CRITICAL)
LOG_LEVEL=INFO

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8501,http://localhost:8000

# Security
SECRET_KEY=change-me-in-production-use-a-long-random-string
REQUIRE_AUTH=false
API_KEY=

# Request Limits
MAX_REQUEST_BODY_MB=5
MAX_SHOW_OUTPUT_CHARS=30000
MAX_COMMAND_OUTPUT_CHARS=5000

# Rate Limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_DIAGNOSE=10/minute
RATE_LIMIT_DEFAULT=100/minute

# Prompt versioning
PROMPT_VERSION=netsage-diagnose-v1
