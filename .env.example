# =============================================================================
# NetSage AI — Unified Deployment Environment Configuration
# =============================================================================

# Application Environment (development | testing | production)
ENVIRONMENT=production
DEBUG=false
APP_NAME=NetSage AI
APP_VERSION=1.0.0

# Backend Security
SECRET_KEY=generate-a-strong-random-secret-key-32-chars-min
REQUIRE_AUTH=false
API_KEY=

# Database Configuration (SQLite by default, or PostgreSQL)
DATABASE_URL=sqlite:////app/data/netsage.db
# DATABASE_URL=postgresql://netsage:password@postgres:5432/netsage

# AI Provider Configuration (mock | openai | gemini | anthropic)
AI_PROVIDER=mock
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=3
AI_FALLBACK_PROVIDER=mock

# CORS & Networking
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:80,http://localhost:8000
VITE_API_BASE_URL=

# Logging & Observability
LOG_LEVEL=INFO
